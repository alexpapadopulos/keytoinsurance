# Copy to .env and fill in. .env is gitignored and must never be committed.

# SiteGround SSH/SFTP
SG_SSH_HOST=
SG_SSH_PORT=18765
SG_SSH_USER=
# Path to the PRIVATE key file (not the key contents)
SG_SSH_KEY_PATH=
# Web root of the temporary/staging site, e.g. ~/www/<temp-domain>/public_html
SG_REMOTE_PATH_STAGING=
# Web root of the live site (leave blank until go-live is approved)
SG_REMOTE_PATH_PRODUCTION=

# Domains
STAGING_DOMAIN=
PRODUCTION_DOMAIN=thekeytoinsurance.com
